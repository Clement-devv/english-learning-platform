    },
    {
      "name": "preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "port": 4173
    },
    {
      "name": "dev-phone",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--host",
