server/logs/
*.log

# Uploads — mounted as Docker volume in production
server/uploads/

# Git & CI
.git/
.github/

# Dev/editor files
.vscode/
.claude/
*.md
!server/package*.json
!package*.json

# OS noise
.DS_Store
Thumbs.db
