# English Learning Platform — Caddyfile
# Caddy handles ALL HTTPS automatically — no certbot needed.
#
# DNS setup required at your registrar (clemify.com):
#   A record: clemify.com    → YOUR_SERVER_IP
#   A record: *.clemify.com  → YOUR_SERVER_IP   (wildcard — all center subdomains)

{
  email speak2clem@gmail.com

  # On-demand TLS: auto-provision certs for verified custom domains.
  # Before issuing a cert for any domain not matching *.clemify.com,
  # Caddy calls this endpoint. Your app returns 200 if the domain is verified, 404 otherwise.
  on_demand_tls {
    ask http://app:5000/api/v1/center/verify-caddy
  }
}

# ── Main platform + all center subdomains ──────────────────────────────────────
# Handles: clemify.com, www.clemify.com, any-slug.clemify.com
clemify.com, *.clemify.com {
  reverse_proxy app:5000 {
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-Host  {host}
    header_up X-Real-IP         {remote_host}
  }

  # Security headers
  header {
    Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    X-Content-Type-Options    "nosniff"
    X-Frame-Options           "SAMEORIGIN"
    Referrer-Policy           "strict-origin-when-cross-origin"
    -Server
  }

  # Compress text assets
  encode gzip zstd

  # Cache static frontend assets (fingerprinted by Vite)
  @static {
    path_regexp \.(js|css|woff2?|ttf|otf|png|jpg|jpeg|gif|svg|ico|webp)$
    not path /api/*
  }
  header @static Cache-Control "public, max-age=31536000, immutable"
}

# ── Custom center domains (e.g., sunshine-school.com) ─────────────────────────
# on_demand TLS provisions SSL cert automatically for any verified custom domain.
# The verify-caddy endpoint prevents cert issuance for unknown domains.
:443 {
  tls {
    on_demand
  }

  reverse_proxy app:5000 {
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-Host  {host}
    header_up X-Real-IP         {remote_host}
  }

  encode gzip zstd

  header {
    Strict-Transport-Security "max-age=63072000"
    X-Content-Type-Options    "nosniff"
    -Server
  }
}
